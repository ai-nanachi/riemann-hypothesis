theorem exists_append_li {a r : ℕ} (u0 : Fin a → (Fin r → ℚ)) (hu0 : LinearIndependent ℚ u0)
    (w : Fin r → (Fin r → ℚ)) (hw : LinearIndependent ℚ w) :
    ∃ m, ∃ f : Fin m → Fin r, a + m = r ∧ LinearIndependent ℚ (Fin.append u0 (w ∘ f)) := by
  classical
  let s := Set.range u0
  let t := s ∪ Set.range w
  let hst : s ⊆ t := Set.subset_union_left
  let S := hu0.linearIndepOn_id.extend hst
  have htop : ⊤ ≤ Submodule.span ℚ t := by
    rw [← hw.span_eq_top_of_card_eq_finrank' (by simp)]
    exact Submodule.span_mono Set.subset_union_right
  let b := Module.Basis.extendLe hu0.linearIndepOn_id hst htop
  let _ : Finite S := Module.Finite.finite_basis b
  let _ := Fintype.ofFinite (S \ s : Set (Fin r → ℚ))
  let m := Fintype.card (S \ s : Set (Fin r → ℚ))
  let g : Fin m ≃ (S \ s : Set (Fin r → ℚ)) := (Fintype.equivFin _).symm
  have hmem (i : Fin m) : (g i : Fin r → ℚ) ∈ Set.range w :=
    (hu0.linearIndepOn_id.extend_subset hst (g i).2.1).resolve_left (g i).2.2
  choose f hf using hmem
  let e : Fin (a + m) ≃ S := finSumFinEquiv.symm.trans <|
    (Equiv.sumCongr (Equiv.ofInjective u0 hu0.injective) g).trans <|
      Equiv.Set.sumDiffSubset (hu0.linearIndepOn_id.subset_extend hst)
  refine ⟨m, f, ?_, (linearIndependent_equiv' e ?_).mpr b.linearIndependent⟩
  · simpa using (Module.finrank_eq_card_basis (b.reindex e.symm)).symm
  · funext i
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i
    · simp [e, b, Function.comp_def]
    · simp [e, b, Function.comp_def, hf]

